{
	"activity": {
		"name": "chatthreader-login-watch",
		"description": "Deletes the login chat of an IM account once it has signed in",
		"type": {
			"immediate": true,
			"priority": "normal",
			"persist": true,
			"explicit": true,
			"power": true,
			"powerDebounce": true
		},
		"trigger": {
			"key": "fired",
			"method": "luna://com.palm.db/watch",
			"params": {
				"query": {
					"from": "com.palm.imloginstate:1",
					"where": [
						{
							"prop": "_rev",
							"op": ">",
							"val": 0
						}
					]
				}
			}
		},
		"callback": {
			"method": "luna://org.webosports.service.messaging/loginsChanged",
			"params": {
				"lastLoginRev": 0
			}
		}
	},
	"start": true,
	"replace": true
}
